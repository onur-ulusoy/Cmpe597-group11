{
    "model_type": "type1",
    "train_json": "data/memes-trainval.json",
    "image_root": "data/memes",
    "output_dir": "outputs/retrieval/clip_projection",
    "run_name": "type1_caption_hn",
    "clip_model": "ViT-L-14",
    "pretrained": "laion2b_s32b_b82k",
    "target_text_mode": "caption",
    "fusion_alpha": 0.5,
    "proj_dim": 256,
    "hidden_dim": 512,
    "dropout": 0.1,
    "batch_size": 256,
    "feature_batch_size": 128,
    "epochs": 20,
    "lr": 0.001,
    "weight_decay": 0.0001,
    "label_smoothing": 0.05,
    "grad_clip": 1.0,
    "val_ratio": 0.1,
    "seed": 42,
    "use_cache": true,
    "use_hard_negatives": true,
    "num_hard_negatives": 10,
    "hard_negative_weight": 0.2
}